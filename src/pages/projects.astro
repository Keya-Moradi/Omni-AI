---
import BaseLayout from '../layouts/BaseLayout.astro';
import projects from '../data/projects';
---

<BaseLayout
  title="Projects — Omni"
  description="Active and in-progress projects with succinct summaries and stacks."
>
  <section>
    <p class="eyebrow">Projects</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">
      Ongoing projects
    </h1>
    <p class="mt-3 text-slate-600">
      Lightweight, living projects. Each has a small, clear scope so it can stay simple and ship
      often.
    </p>
  </section>

  <section class="mt-8 space-y-4">
    {projects.map((project) => (
      <article class="surface p-6">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="text-xl font-semibold text-slate-900">{project.title}</h2>
          <span class="rounded-full bg-slate-100 px-3 py-1 text-xs text-slate-700">
            {project.status}
          </span>
        </div>
        <p class="mt-2 text-sm text-slate-700">{project.summary}</p>
        <div class="mt-4 flex flex-wrap gap-2 text-xs text-slate-600">
          {project.stack.map((tech) => (
            <span class="rounded-md border border-slate-200 px-2 py-1">{tech}</span>
          ))}
        </div>
        {project.links && (
          <div class="mt-4 flex flex-wrap gap-3 text-sm text-slate-700">
            {project.links.map((link) => (
              <a class="rounded-md border border-slate-200 px-3 py-2 hover:text-slate-900" href={link.href}>
                {link.label}
              </a>
            ))}
          </div>
        )}
      </article>
    ))}
  </section>
</BaseLayout>
