---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact — Omni" description="Ways to get in touch for collaborations or questions.">
  <section class="surface p-8">
    <p class="eyebrow">Contact</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">
      Reach out
    </h1>
    <p class="mt-3 text-slate-600">
      Prefer email for anything important. Happy to chat about projects, consulting, or ideas you
      want to test quickly.
    </p>
    <div class="mt-6 space-y-3 text-sm text-slate-700">
      <a class="block rounded-md border border-slate-200 px-4 py-3 hover:text-slate-900" href="mailto:hello@example.com">
        hello@example.com
      </a>
      <div class="flex flex-wrap gap-3">
        <a class="rounded-md border border-slate-200 px-3 py-2 hover:text-slate-900" href="https://www.linkedin.com/">
          LinkedIn
        </a>
        <a class="rounded-md border border-slate-200 px-3 py-2 hover:text-slate-900" href="https://github.com/">
          GitHub
        </a>
        <a class="rounded-md border border-slate-200 px-3 py-2 hover:text-slate-900" href="https://x.com/">
          X (Twitter)
        </a>
      </div>
    </div>
  </section>

  <section class="mt-8 surface p-8">
    <div class="flex items-center justify-between gap-3">
      <div>
        <p class="eyebrow">Optional</p>
        <h2 class="text-xl font-semibold text-slate-900">Quick note</h2>
        <p class="mt-2 text-sm text-slate-600">Wire this form to your provider when ready.</p>
      </div>
      <span class="rounded-full bg-slate-100 px-3 py-1 text-xs text-slate-700">Placeholder</span>
    </div>
    <!-- Replace the action attribute with your form provider endpoint when wiring up -->
    <form class="mt-6 space-y-4" method="post" action="https://example.com/form-endpoint">
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="text-sm text-slate-700">
          Name
          <input class="mt-1 w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm focus:border-slate-400 focus:outline-none" name="name" type="text" placeholder="Your name" />
        </label>
        <label class="text-sm text-slate-700">
          Email
          <input class="mt-1 w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm focus:border-slate-400 focus:outline-none" name="email" type="email" placeholder="you@example.com" />
        </label>
      </div>
      <label class="block text-sm text-slate-700">
        Message
        <textarea
          class="mt-1 w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm focus:border-slate-400 focus:outline-none"
          name="message"
          rows="4"
          placeholder="What can I help with?"
        ></textarea>
      </label>
      <button
        class="w-full rounded-md border border-slate-900 bg-slate-900 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-slate-800 sm:w-auto"
        type="submit"
      >
        Send
      </button>
    </form>
  </section>
</BaseLayout>
