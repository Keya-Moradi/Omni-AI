---
const socials = [
  { label: 'GitHub', href: 'https://github.com/' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/' },
  { label: 'X', href: 'https://x.com/' },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200/80 bg-white/80 backdrop-blur">
  <div class="mx-auto flex max-w-3xl flex-col gap-4 px-6 py-6 text-sm text-slate-600 sm:flex-row sm:items-center sm:justify-between">
    <p>© {year} Omni. Built with Astro.</p>
    <div class="flex flex-wrap items-center gap-3">
      {socials.map((link) => (
        <a class="hover:text-slate-900" href={link.href}>
          {link.label}
        </a>
      ))}
    </div>
  </div>
</footer>
