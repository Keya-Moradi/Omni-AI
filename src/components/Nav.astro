---
const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/blog', label: 'Blog' },
  { href: '/contact', label: 'Contact' },
];

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  pathname === href || (href !== '/' && pathname.startsWith(href));
---

<header class="border-b border-slate-200/80 bg-white/80 backdrop-blur">
  <div class="mx-auto flex max-w-3xl items-center justify-between px-6 py-5">
    <a class="text-sm font-semibold tracking-tight text-slate-900" href="/">
      Omni — Personal OS
    </a>
    <nav>
      <ul class="flex items-center gap-4 text-sm text-slate-600">
        {links.map((link) => (
          <li>
            <a
              class:list={[
                'rounded-md px-2 py-1 transition-colors hover:text-slate-900 hover:bg-slate-100',
                isActive(link.href) && 'text-slate-900 border border-slate-200/80 bg-slate-100',
              ]}
              href={link.href}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
