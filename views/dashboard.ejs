<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body data-csrf="<%= csrfToken %>">
    <div class="page">
        <div class="topbar">
            <h1>Your Conversations</h1>
            <div class="top-actions">
                <a class="badge" href="/logout">Logout</a>
            </div>
        </div>

        <div class="grid two">
            <div class="card stack">
                <h2>Start a conversation</h2>
                <form class="form-stack with-loader" action="/conversation/start" method="POST">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <textarea name="prompt" placeholder="Ask anything to kick off a thread" required></textarea>
                    <button type="submit">Submit</button>
                </form>
                <div class="loading-indicator" aria-live="polite">
                    <span class="dot-pulse"></span> <span>Saving...</span>
                </div>
            </div>

            <div class="card stack">
                <h2>All threads</h2>
                <% if (conversations.length === 0) { %>
                    <p class="muted">No conversations yet.</p>
                <% } else { %>
                    <ul class="list">
                        <% conversations.forEach(function(conversation) { %>
                            <li class="list-item">
                                <div class="list-item-header">
                                    <a href="/conversation/<%= conversation._id %>"><strong><%= conversation.title %></strong></a>
                                    <span class="badge">Open</span>
                                </div>
                                <div class="inline">
                                    <form class="inline with-loader" action="/conversation/edit?_method=PUT" method="POST">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <input type="hidden" name="conversationId" value="<%= conversation._id %>">
                                        <input type="text" name="newTitle" placeholder="Rename" required>
                                        <button type="submit">Update</button>
                                    </form>
                                    <button class="btn-secondary js-delete" data-id="<%= conversation._id %>">Delete</button>
                                </div>
                            </li>
                        <% }); %>
                    </ul>
                <% } %>
            </div>
        </div>
    </div>

    <script>
        const forms = document.querySelectorAll('.with-loader');
        forms.forEach((form) => {
            form.addEventListener('submit', () => {
                const indicator = form.closest('.card')?.querySelector('.loading-indicator');
                const btn = form.querySelector('button[type="submit"]');
                if (btn) btn.disabled = true;
                if (indicator) indicator.classList.add('show');
                overlay.classList.add('show');
                setTimeout(() => overlay.classList.remove('show'), 15000);
            });
        });

        const csrf = document.body.getAttribute('data-csrf');
        const overlay = document.createElement('div');
        overlay.className = 'overlay';
        overlay.innerHTML = `<div class="modal"><div class="loading-indicator show"><span class="dot-pulse"></span><span>Processing...</span></div></div>`;
        document.body.appendChild(overlay);

        const startForm = document.querySelector('form[action="/conversation/start"]');
        if (startForm) {
            startForm.addEventListener('submit', () => {
                const btn = startForm.querySelector('button[type="submit"]');
                if (btn) btn.disabled = true;
                overlay.classList.add('show');
                setTimeout(() => overlay.classList.remove('show'), 15000);
            });
        }

        // Delete confirmation
        const modal = document.createElement('div');
        modal.className = 'overlay';
        modal.innerHTML = `
            <div class="modal">
                <h3>Delete conversation?</h3>
                <p class="muted">Do you really want to delete this conversation?</p>
                <div class="modal-actions">
                    <button class="btn-secondary" data-action="cancel">Cancel</button>
                    <button data-action="confirm">Delete</button>
                </div>
            </div>`;
        document.body.appendChild(modal);

        let pendingDeleteId = null;
        modal.addEventListener('click', async (e) => {
            if (e.target.dataset.action === 'cancel' || e.target === modal) {
                pendingDeleteId = null;
                modal.classList.remove('show');
            }
            if (e.target.dataset.action === 'confirm' && pendingDeleteId) {
                try {
                    overlay.classList.add('show');
                    const res = await fetch(`/conversation/delete/${pendingDeleteId}?_method=DELETE`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded'
                        },
                        body: `_csrf=${encodeURIComponent(csrf)}`,
                        credentials: 'same-origin'
                    });
                    if (res.ok) {
                        const item = document.querySelector(`[data-id="${pendingDeleteId}"]`)?.closest('.list-item');
                        if (item) item.remove();
                    }
                } catch (err) {
                    console.error('Delete failed', err);
                } finally {
                    pendingDeleteId = null;
                    modal.classList.remove('show');
                    overlay.classList.remove('show');
                }
            }
        });

        document.querySelectorAll('.js-delete').forEach((btn) => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                pendingDeleteId = btn.getAttribute('data-id');
                modal.classList.add('show');
            });
        });
    </script>
</body>
</html>
